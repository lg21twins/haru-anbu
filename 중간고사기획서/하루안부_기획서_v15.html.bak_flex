        #sdesign2 .ds-btn{display: inline-flex;align-items: center;gap: 8px;padding: 11px 16px;border-radius: 14px;font-size: 13px;font-weight: 700;border: 0;font-family: inherit;}
        #sdesign2 .ds-btn-primary{background: var(--blue);color: #fff;}
        #sdesign2 .ds-btn-secondary{background: rgba(44,122,252,.08);color: var(--blue);}
        #sdesign2 .ds-btn-ghost{background: transparent;color: #2a1810;border: 1px solid rgba(0,0,0,.06);}
        #sdesign2 .ds-btn-danger{background: rgba(239,68,68,.08);color: var(--danger);}
        #sdesign2 .ds-btn-pill{border-radius: var(--radius-pill);}
        #sdesign2 .ds-badge{display: inline-flex;align-items: center;padding: 3px 10px;font-size: 11px;font-weight: 700;border-radius: var(--radius-pill);}
        #sdesign2 .ds-chip{display: inline-flex;align-items: center;gap: 8px;padding: 7px 13px;border-radius: var(--radius-pill);font-size: 12px;font-weight: 600;background: #fff;border: 1px solid rgba(0,0,0,.06);color: #2a1810;}
        #sdesign2 .ds-chip.active{background: var(--blue);color: #fff;border-color: var(--blue);}
        #sdesign2 .ds-avatar{width: 40px;height: 40px;border-radius: 50%;display: inline-flex;align-items: center;justify-content: center;color: #fff;font-weight: 600;font-size: 14px;}
        #sdesign2 .ds-bubble{max-width: 85%;padding: 9px 13px;border-radius: var(--radius-lg);font-size: 12px;line-height: 1.4;}
        #sdesign2 .ds-bubble.in{background: #fff;border: 1px solid rgba(0,0,0,.06);border-bottom-left-radius:5px;color: var(--ink);align-self: flex-start;}
        #sdesign2 .ds-bubble.out{background: var(--blue);color: #fff;border-bottom-right-radius:5px;align-self: flex-end;}
        #sdesign2 .ds-input{padding: 10px 14px;border-radius: var(--radius-pill);border: 1px solid rgba(0,0,0,.06);background: rgba(255,255,255,.92);font-size: 12px;color: #8E8E93;display: flex;align-items: center;gap: 8px;}
        #sdesign2 .ds-nav-btn{width: 40px;height: 40px;border-radius: 50%;background: rgba(255,255,255,.6);border: .5px solid rgba(255,255,255,.55);box-shadow: var(--shadow-md);display: inline-flex;align-items: center;justify-content: center;color: var(--blue);position: relative;}
        #sdesign2 .ds-nav-btn iconify-icon{font-size: 20px;}
        #sdesign2 .ds-nav-btn .dot{position: absolute;top: 7px;right: 7px;width: 7px;height: 7px;border-radius: 50%;background: var(--danger);border: 2px solid #fff;}
        #sdesign2 .ds-tabbar{height: 54px;background: rgba(210,225,250,.55);backdrop-filter: blur(12px);-webkit-backdrop-filter: blur(12px);border: 1px solid rgba(255,255,255,.45);border-radius: var(--radius-pill);box-shadow: var(--shadow-md);display: flex;align-items: stretch;justify-content: space-around;padding: 0 8px;flex: 1;}
        #sdesign2 .ds-tab{flex: 1;display: flex;align-items: center;justify-content: center;color: rgba(42,24,16,.48);}
        #sdesign2 .ds-tab iconify-icon,#sdesign2 .ds-tab svg{font-size: 22px;width: 22px;height: 22px;color: inherit;fill:currentColor;}
        #sdesign2 .ds-tab.active{color: var(--blue);}
        #sdesign2 .ds-fab{width: 52px;height: 52px;border-radius: 50%;background: rgba(180,210,250,.28);backdrop-filter: blur(4px);-webkit-backdrop-filter: blur(4px);border: 1px solid rgba(255,255,255,.45);box-shadow: var(--shadow-md),inset 0 1px 0 rgba(255,255,255,.3);display: flex;align-items: center;justify-content: center;flex-shrink: 0;}
        #sdesign2 .ds-icon-cell{background: rgba(255,255,255,.92);border: 1px solid rgba(0,0,0,.04);border-radius: 14px;padding: 10px 6px 8px;display: flex;flex-direction: column;align-items: center;gap: 8px;box-shadow: var(--shadow-sm);}
        #sdesign2 .ds-icon-cell iconify-icon{font-size: 22px;color: var(--blue);}
        #sdesign2 .ds-icon-cell span{font-size: 10px;color: rgba(42,24,16,.72);font-weight: 600;text-align: center;line-height: 1.2;}
