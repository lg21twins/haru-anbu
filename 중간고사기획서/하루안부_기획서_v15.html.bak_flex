    <style>
        #sdesign2 .ds-card{background: rgba(255,255,255,.92);border: 1px solid rgba(0,0,0,.04);border-radius: 20px;box-shadow: var(--shadow-sm);padding: 22px;display: flex;flex-direction: column;gap: 12px;}
