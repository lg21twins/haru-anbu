<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8" />
    <title>하루안부 기획서 V12</title>
    <style>
        @import url("https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css");

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        p {
            line-height: 1.6;
        }

        :root {
            /* ── Brand ── */
            --blue:        #2c7afc;
            --navy:        #111318;

            /* ── Text ── */
            --ink:         #161616;
            --slate:       #64748b;
            --gray-sub:    #475569;
            --gray-muted:  #94a3b8;
            --gray-mid:    #b3b3b3;

            /* ── Surface / Divider ── */
            --rule:        #e4e4e4;
            --ghost:       rgba(255,255,255,0.04);

            /* ── Semantic ── */
            --success:     #22c55e;
            --green:       #10b981;
            --warning:     #d97706;
            --orange:      #fb923c;
            --danger:      #ef4444;

            /* ── Radius ── */
            --radius-sm:   8px;
            --radius-md:   12px;
            --radius-lg:   16px;
            --radius-xl:   24px;
            --radius-pill: 100px;

            /* ── Shadow ── */
            --shadow-sm:   0 2px 8px rgba(0,0,0,.05);
            --shadow-md:   0 4px 16px rgba(0,0,0,.08);

            /* ── Dark-mode text layers ── */
            --white-hi:     rgba(255,255,255,0.85);
            --white-md:     rgba(255,255,255,0.55);
            --white-lo:     rgba(255,255,255,0.25);
            --white-border: rgba(255,255,255,0.08);

            /* ── Dark-mode surfaces ── */
            --blue-light:  #5b9bff;
            --card-dark:   #1c1d21;
        }

        body {
            font-family: "Pretendard Variable", Pretendard, sans-serif;
            background: #dadde0;
            padding: 24px;
            word-break: keep-all;
            overflow-wrap: break-word;
        }

        .slide-outer {
            width: 100%;
            overflow: hidden;
            position: relative;
            margin-bottom: 24px;
            line-height: 0;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .slide {
            width: 1920px;
            height: 1080px;
            background: #fff;
            position: relative;
            overflow: hidden;
            transform-origin: top left;
            display: block;
            line-height: normal;
        }

        .slide-dark {
            background: #111318 !important;
        }

        /* TOP BAR v3 */
        .top-bar {
            position: absolute;
            top: 80px;
            left: 88px;
            right: 88px;
            height: 40px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--rule);
            z-index: 10;
        }

        .top-bar-section {
            font-size: 14px;
            font-weight: 600;
            color: var(--ink);
            width: 197px;
            flex-shrink: 0;
        }

        .top-bar-sub {
            font-size: 14px;
            font-weight: 400;
            color: var(--gray-mid);
            flex: 1;
            white-space: nowrap;
            overflow: hidden;
            padding-left: 24px;
        }

        .top-bar-course {
            font-size: 14px;
            font-weight: 400;
            color: var(--gray-mid);
            flex-shrink: 0;
        }

        /* PAGINATION v3 */
        .pg-v3 {
            position: absolute;
            top: 1016px;
            right: 88px;
            line-height: 1;
        }

        .pg-v3 .pgc {
            font-size: 14px;
            font-weight: 600;
            color: var(--ink);
        }

        .pg-v3 .pgt {
            font-size: 14px;
            font-weight: 400;
            color: var(--gray-mid);
        }

        .pg-v3-white .pgc {
            color: #fff;
        }

        .pg-v3-white .pgt {
            color: var(--white-lo);
        }

        /* LINE-METRIC */
        .line-metric {
            display: flex;
            align-items: center;
            margin-bottom: 24px;
        }

        .lm-label {
            font-size: 20px;
            font-weight: 400;
            color: var(--slate);
            min-width: 320px;
            line-height: 1.6;
        }

        .lm-track {
            flex: 1;
            height: 1px;
            background: var(--rule);
            position: relative;
            margin: 0 24px;
        }

        .lm-dot {
            position: absolute;
            right: 0;
            top: 50%;
            transform: translate(50%, -50%);
            width: 10px;
            height: 10px;
            border: 2px solid var(--blue);
            border-radius: 50%;
            background: #fff;
        }

        .lm-val {
            font-size: 40px;
            font-weight: 700;
            letter-spacing: -1px;
            color: var(--navy);
            min-width: 160px;
            text-align: right;
        }

        /* LEAN CANVAS */
        .lc-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            grid-template-rows: 1fr 1fr 1fr;
            width: 100%;
            height: 100%;
        }

        .lc-cell {
            border-right: 1px solid var(--rule);
            border-bottom: 1px solid var(--rule);
            padding: 24px;
            overflow: hidden;
        }

        .lc-cell:nth-child(3n) {
            border-right: none;
        }

        .lc-cell:nth-child(n + 7) {
            border-bottom: none;
        }

        .lc-tag {
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--blue);
            margin-bottom: 8px;
        }

        .lc-body {
            font-size: 20px;
            font-weight: 400;
            line-height: 1.6;
            color: var(--slate);
        }

        /* PHONE MOCK */
        .phone-mock {
            width: 240px;
            height: 480px;
            border: 2px solid var(--rule);
            border-radius: 32px;
            background: #fff;
            position: relative;
            overflow: hidden;
            flex-shrink: 0;
        }

        .phone-mock-dark {
            background: #f5f7fa;
        }

        .phone-screen {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            padding: 16px 12px;
            overflow: hidden;
        }

        .phone-status {
            font-size: 10px;
            font-weight: 500;
            color: var(--ink);
            text-align: center;
            margin-bottom: 8px;
        }

        /* STAT CARD */
        .stat-card {
            border: 1px solid var(--rule);
            border-left: 4px solid var(--blue);
            padding: 32px;
            background: #f9f9f9;
            border-radius: var(--radius-lg);
        }

        .stat-num {
            font-size: 56px;
            font-weight: 700;
            color: var(--blue);
            letter-spacing: -1px;
            line-height: 1;
        }

        .stat-label {
            font-size: 20px;
            font-weight: 400;
            color: var(--slate);
            margin-top: 8px;
            line-height: 1.6;
        }

        .stat-source {
            font-size: 16px;
            font-weight: 400;
            color: var(--gray-mid);
            margin-top: 4px;
        }

        /* BAR CHART */
        .bar-wrap {
            margin-bottom: 24px;
        }

        .bar-label {
            font-size: 16px;
            font-weight: 500;
            color: var(--ink);
            margin-bottom: 8px;
        }

        .bar-bg {
            height: 56px;
            background: #f9f9f9;
            border-radius: var(--radius-sm);
            position: relative;
            overflow: hidden;
        }

        .bar-fill {
            height: 100%;
            background: var(--blue);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding-right: 14px;
        }

        .bar-fill-val {
            font-size: 16px;
            font-weight: 600;
            color: #fff;
        }

        /* INSIGHT CARD */
        .insight-card {
            background: #f9f9f9;
            padding: 32px 40px;
            margin-bottom: 16px;
            border-radius: var(--radius-md);
        }

        .insight-card-dark {
            background: var(--card-dark);
            padding: 32px 40px;
            margin-bottom: 16px;
            border-radius: var(--radius-md);
        }

        /* QUOTE BLOCK */
        .quote-block {
            border-left: 4px solid var(--blue);
            padding: 24px 32px;
            background: #f9f9f9;
            border-radius: var(--radius-sm);
        }

        .quote-block-dark {
            border-left: 4px solid var(--blue);
            padding: 24px 32px;
            background: var(--card-dark);
            border-radius: var(--radius-sm);
        }

        .quote-mark {
            font-size: 40px;
            font-weight: 700;
            color: var(--rule);
            line-height: 1;
            margin-bottom: 8px;
            display: block;
        }

        /* SOURCE TEXT */
        .src {
            font-size: 16px;
            font-weight: 400;
            color: var(--gray-mid);
            margin-top: 8px;
        }

        /* EYEBROW / SLIDE-TITLE / CONTENT-ZONE */
        .eyebrow {
            position: absolute;
            top: 168px;
            left: 88px;
            font-size: 14px;
            font-weight: 500;
            color: var(--blue);
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .slide-title {
            position: absolute;
            top: 208px;
            left: 88px;
            right: 88px;
            font-size: 40px;
            font-weight: 600;
            color: var(--ink);
            line-height: 1.2;
            letter-spacing: -0.5px;
        }

        .content-zone {
            position: absolute;
            top: 288px;
            left: 88px;
            right: 88px;
            bottom: 120px;
        }

        /* AI IMAGE BOX */
        .ai-img-box {
            background: #d0d0d0;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .ai-img-label {
            font-size: 16px;
            font-weight: 400;
            color: #888;
            text-align: center;
            padding: 16px;
            line-height: 1.6;
        }

        /* POSITIONING MAP */
        .pos-map {
            position: relative;
            border: 1px solid var(--rule);
        }

        .pos-dot {
            position: absolute;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            transform: translate(-50%, -50%);
        }

        /* PILL TAG */
        .pill {
            display: inline-block;
            /* padding: 4px 14px; */
            border-radius: var(--radius-pill);
            font-size: 14px;
            font-weight: 500;
            margin-right: 8px;
            margin-bottom: 8px;
        }

        .pill-blue {
            background: transparent;
            color: var(--blue);
        }

        .pill-gray {
            background: var(--rule);
            color: var(--slate);
        }

        /* FLOWCHART */
        .fc-box {
            border: 1px solid var(--blue);
            padding: 12px 24px;
            font-size: 16px;
            font-weight: 500;
            color: var(--ink);
            text-align: center;
            background: #fff;
            border-radius: var(--radius-sm);
        }

        .fc-box-blue {
            border: 1px solid var(--blue);
            padding: 12px 24px;
            font-size: 16px;
            font-weight: 500;
            color: #fff;
            text-align: center;
            background: var(--blue);
            border-radius: var(--radius-sm);
        }

        .fc-arrow {
            font-size: 20px;
            color: var(--blue);
            margin: 0 8px;
        }

        /* 3COL */
        .three-col {
            display: flex;
            gap: 0;
        }

        .three-col-item {
            flex: 1;
            padding: 0 40px;
            border-right: 1px solid var(--rule);
            overflow: hidden;
        }

        .three-col-item:first-child {
            padding-left: 0;
        }

        .three-col-item:last-child {
            border-right: none;
            padding-right: 0;
        }

        /* SWOT */
        .swot-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-template-rows: 1fr 1fr;
            gap: 0;
            border: 1px solid var(--rule);
        }

        .swot-cell {
            padding: 40px;
            border-right: 1px solid var(--rule);
            border-bottom: 1px solid var(--rule);
            overflow: hidden;
        }

        .swot-cell:nth-child(2n) {
            border-right: none;
        }

        .swot-cell:nth-child(n + 3) {
            border-bottom: none;
        }

        .swot-tag {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 2px;
            color: var(--blue);
            margin-bottom: 16px;
        }

        /* V2 TOC ROW */
        .toc-row-v3 {
            display: flex;
            align-items: center;
            padding: 20px 0;
            border-bottom: 1px solid var(--rule);
        }

        .toc-row-v3-dark {
            display: flex;
            align-items: center;
            padding: 20px 0;
            border-bottom: 1px solid var(--white-lo);
        }

        /* TOC ROW DK dark section intro slides */
        .toc-row-dk {
            display: flex;
            align-items: center;
            padding: 34px 0;
            border-bottom: 1px solid var(--white-border);
        }

        .toc-row-dk .tr-num {
            color: var(--white-lo);
        }

        .toc-row-dk .tr-title {
            color: var(--white-lo);
        }

        .toc-row-dk .tr-sub,
        .toc-row-dk .tr-pg {
            color: var(--white-lo);
        }

        .toc-row-dk.active .tr-num {
            color: var(--blue);
        }

        .toc-row-dk.active .tr-title {
            color: var(--blue-light);
        }

        .toc-row-dk.active .tr-sub,
        .toc-row-dk.active .tr-pg {
            color: rgba(44, 122, 252, 0.65);
        }

        .tr-num {
            font-size: 14px;
            font-weight: 600;
            color: var(--blue);
            width: 88px;
            flex-shrink: 0;
            letter-spacing: 2px;
        }

        .tr-title {
            font-size: 32px;
            font-weight: 600;
            color: var(--ink);
            width: 320px;
            flex-shrink: 0;
            line-height: 1.2;
            letter-spacing: -0.5px;
        }

        .tr-title-dark {
            font-size: 32px;
            font-weight: 600;
            color: #fff;
            width: 320px;
            flex-shrink: 0;
            line-height: 1.2;
            letter-spacing: -0.5px;
        }

        .tr-title-active {
            font-size: 32px;
            font-weight: 600;
            color: var(--blue);
            width: 320px;
            flex-shrink: 0;
            line-height: 1.2;
            letter-spacing: -0.5px;
        }

        .tr-sub {
            font-size: 20px;
            font-weight: 400;
            color: var(--gray-mid);
            flex: 1;
            white-space: nowrap;
            line-height: 1.6;
        }

        .tr-sub-dark {
            font-size: 20px;
            font-weight: 400;
            color: var(--white-lo);
            flex: 1;
            white-space: nowrap;
            line-height: 1.6;
        }

        .tr-sub-active {
            font-size: 20px;
            font-weight: 400;
            color: rgba(44, 122, 252, 0.7);
            flex: 1;
            white-space: nowrap;
            line-height: 1.6;
        }

        .tr-pg {
            font-size: 14px;
            font-weight: 400;
            color: var(--gray-mid);
            width: 64px;
            text-align: right;
            flex-shrink: 0;
        }

        .tr-pg-dark {
            font-size: 14px;
            font-weight: 400;
            color: var(--white-lo);
            width: 64px;
            text-align: right;
            flex-shrink: 0;
        }

        .tr-pg-active {
            font-size: 14px;
            font-weight: 400;
            color: var(--blue);
            width: 64px;
            text-align: right;
            flex-shrink: 0;
        }

        /* SECTION INTRO TOP NAV */
        .intro-nav {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 56px;
            border-bottom: 1px solid var(--white-lo);
            display: flex;
            align-items: center;
            padding: 0 88px;
            z-index: 10;
        }

        .intro-nav-logo {
            height: 20px;
            margin-right: auto;
            filter: brightness(0) invert(1);
        }

        .intro-nav-items {
            display: flex;
            align-items: center;
            gap: 48px;
        }

        .intro-nav-item {
            font-size: 11px;
            font-weight: 500;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--white-lo);
        }

        .intro-nav-item.cur {
            color: #fff;
            border-bottom: 1.5px solid #fff;
            padding-bottom: 2px;
        }

        /* SCREEN */
        @media screen {
            .slide-outer {
                height: calc(var(--ss, 0.7) * 1080px);
            }

            .slide {
                transform: scale(var(--ss, 0.7));
            }
        }

        @media print {
            @page {
                size: 20in 11.25in;
                margin: 0;
            }

            body {
                background: none !important;
                padding: 0 !important;
                margin: 0 !important;
            }

            .slide-outer {
                break-inside: avoid;
                page-break-inside: avoid;
                page-break-after: always;
                margin: 0 !important;
                overflow: visible !important;
                height: 1080px !important;
            }

            .slide {
                transform: none !important;
                margin: 0 !important;
            }
        }

        /* STORYBOARD SLIDES */
        .sb-content {
            position: absolute;
            top: 200px;
            left: 88px;
            right: 88px;
            bottom: 120px;
            display: flex;
            gap: 64px;
            align-items: flex-start;
        }

        .sb-img-panel {
            flex: 1 1 0;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f4f5f7;
            border-radius: 20px;
            overflow: hidden;
        }

        .sb-img-panel img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .sb-txt-panel {
            width: 480px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            gap: 32px;
            padding-top: 8px;
        }

        .sb-eyebrow {
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--blue);
        }

        .sb-title {
            font-size: 36px;
            font-weight: 600;
            color: var(--ink);
            line-height: 1.2;
            margin-top: 12px;
        }

        .sb-desc {
            font-size: 18px;
            font-weight: 400;
            color: var(--slate);
            line-height: 1.7;
        }

        .sb-scene-list {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .sb-scene-item {
            display: flex;
            gap: 16px;
            align-items: flex-start;
        }

        .sb-scene-num {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #f0f4ff;
            border: 1px solid #d0dbff;
            font-size: 12px;
            font-weight: 600;
            color: var(--blue);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-top: 1px;
        }

        .sb-scene-text {
            font-size: 16px;
            font-weight: 400;
            color: #3a4051;
            line-height: 1.6;
        }

        .sb-scene-text strong {
            font-weight: 600;
            color: var(--ink);
        }

        .sb-tag-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .sb-tag {
            padding: 6px 14px;
            border-radius: var(--radius-pill);
            background: #f0f4ff;
            font-size: 14px;
            font-weight: 500;
            color: var(--blue);
        }

        .sb-tag-gray {
            background: #f1f1f1;
            color: var(--slate);
        }

        .sb-divider {
            width: 100%;
            height: 1px;
            background: #e2e8f0;
        }
    </style>
</head>

<body>
    <!-- S01 COVER -->
    <div class="slide-outer">
        <section class="slide slide-dark" id="s01">
            <img src="../%ED%91%9C%EC%A7%80%EC%9D%B4%EB%AF%B8%EC%A7%80.png" style="
                        position: absolute;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 100%;
                        object-fit: cover;
                        display: block;
                        z-index: 0;
                    " onerror="this.style.display='none'" />
            <div style="
                        position: absolute;
                        top: 0;
                        left: 0;
                        right: 0;
                        bottom: 0;
                        background: rgba(0, 0, 0, 0.62);
                        z-index: 1;
                    "></div>
            <div style="
                        position: absolute;
                        top: 0;
                        left: 0;
                        right: 0;
                        bottom: 0;
                        z-index: 2;
                    ">
                <div style="
                            position: absolute;
                            top: 80px;
                            left: 88px;
                            display: flex;
                            gap: 80px;
                            align-items: flex-start;
                        ">
                    <div>
                        <p style="
                                    font-size: 16px;
                                    font-weight: 500;
                                    color: var(--gray-mid);
                                    letter-spacing: 1px;
                                    margin-bottom: 8px;
                                ">
                            TEAM.
                        </p>
                        <p style="
                                    font-size: 20px;
                                    font-weight: 400;
                                    color: #fff;
                                    line-height: 1.6;
                                ">
                            노인과 바다 그리고 네잎클로버<br />김지욱 손예찬
                            고해은
                        </p>
                    </div>
                    <div>
                        <p style="
                                    font-size: 16px;
                                    font-weight: 500;
                                    color: var(--gray-mid);
                                    letter-spacing: 1px;
                                    margin-bottom: 8px;
                                ">
                            PROF.
                        </p>
                        <p style="
                                    font-size: 20px;
                                    font-weight: 400;
                                    color: #fff;
                                ">
                            남궁경
                        </p>
                    </div>
                </div>
                <p style="
                            position: absolute;
                            top: 80px;
                            right: 88px;
                            font-size: 16px;
                            font-weight: 500;
                            color: var(--gray-mid);
                            letter-spacing: 1px;
                        ">
                    DIGITAL CONTENT
                </p>
                <div style="
                            position: absolute;
                            top: 50%;
                            left: 50%;
                            transform: translate(-50%, -55%);
                            text-align: center;
                        ">
                    <img src="./logo/haru.svg" style="
                                height: 200px;
                                width: auto;
                                filter: brightness(0) invert(1);
