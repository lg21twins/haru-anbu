{
  "target": "mobile-apps",
  "description": "모바일 3종(v11 보호자, v11 요양보호사, v15 의료진) + 확장 폴더 통합 감사 (audit v0.2)",

  "folders": [
    "v11_보호자앱",
    "v11_요양보호사앱",
    "v15_의료진앱",
    "v12_환자앱",
    "v13_온보딩",
    "v10_의료진웹"
  ],

  "representative_screens": [
    "v11_보호자앱/g-guardian-live.html",
    "v11_요양보호사앱/c01-today.html",
    "v15_의료진앱/d01-home.html"
  ],

  "include_extensions": [".html", ".css", ".md", ".js"],

  "exclude": [
    "_archive/",
    "_history/",
    "node_modules/",
    "mockup/",
    "references/",
    "review-assets/"
  ],

  "allowed_token_definition_files": [
    "07_디자인/tokens/tokens.css"
  ],

  "allowed_local_token_patterns": [
    "--bar-w",
    "--bar-h",
    "--bar-op",
    "--mp",
    "--ww",
    "--score-color",
    "--trend-color",
    "--bar-bg",
    "--gauge-color",
    "--ring-color",
    "--ink",
    "--ink-2",
    "--ink-3",
    "--ink-4",
    "--ink-5",
    "--bg"
  ],

  "js_hex_allowed_files": [
    "v10_의료진웹/의료진_대시보드_v9.5.html",
    "v10_의료진웹/의료진_대시보드_v9.5.en.html"
  ],

  "rules": {
    "max_inline_style": 0,
    "max_direct_hex_in_body": 0,
    "max_emoji": 0,
    "forbidden_classes": ["col__hex"]
  }
}
